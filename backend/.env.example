PORT=8080
DATABASE_URL=postgres://user:password@localhost:5432/octo_crm?sslmode=disable
JWT_SECRET=your-secure-jwt-secret-here
JWT_EXPIRATION=168h
ENVIRONMENT=development
CORS_ORIGIN=*

# Public Frontend Web App URL (Set in Railway to your live Vercel domain, e.g. https://octo-crm.vercel.app)
FRONTEND_URL=https://your-crm.vercel.app

# Email Delivery: Option 1 (RECOMMENDED FOR RAILWAY) - Brevo HTTPS REST API (Port 443, never blocked)
BREVO_API_KEY=xkeysib-your-brevo-api-key

# Email Delivery: Option 2 - Standard SMTP Relay
# NOTE FOR RAILWAY: Railway blocks port 25 and often port 587. For Brevo SMTP, use Port 2525.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_USER=your_brevo_login_email
SMTP_PASS=your_smtp_key
SMTP_FROM=no-reply@yourdomain.com
