PORT=8080
DATABASE_URL=postgres://user:password@localhost:5432/octo_crm?sslmode=disable
JWT_SECRET=your-secure-jwt-secret-here
JWT_EXPIRATION=168h
ENVIRONMENT=development
CORS_ORIGIN=*

# SMTP Email Configuration (Optional / Escalation notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=no-reply@example.com
